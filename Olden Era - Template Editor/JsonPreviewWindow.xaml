<Window x:Class="Olden_Era___Template_Editor.JsonPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{DynamicResource S.JP.Title}"
        Height="720" Width="860"
        MinWidth="600" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}"
        UseLayoutRounding="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S.JP.Hint}"
                   Foreground="{StaticResource BrushTextDim}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TextBox Grid.Row="1" x:Name="TxtJson"
                 FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12"
                 Height="{x:Static sys:Double.NaN}" VerticalContentAlignment="Top"
                 AcceptsReturn="True" AcceptsTab="True"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 Background="{StaticResource BrushInput}" Foreground="{StaticResource BrushText}"
                 BorderBrush="{StaticResource BrushBorder}" Padding="6"/>

        <TextBlock Grid.Row="2" x:Name="TxtStatus" Foreground="{StaticResource BrushTextDim}"
                   FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource S.JP.Reformat}" Width="150" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource ToolbarButton}" Click="BtnReformat_Click"/>
            <Button Content="{DynamicResource S.JP.Copy}" Width="120" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource ToolbarButton}" Click="BtnCopy_Click"/>
            <Button Content="{DynamicResource S.JP.Apply}" Width="130" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource GenerateButton}" Click="BtnApply_Click"/>
            <Button Content="{DynamicResource S.JP.Close}" Width="110" Height="30"
                    IsCancel="True" Style="{StaticResource ToolbarButton}" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
