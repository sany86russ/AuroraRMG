<Window x:Class="Olden_Era___Template_Editor.MirrorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.MR.Title}"
        SizeToContent="Height" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}"
        UseLayoutRounding="True">
    <StackPanel Margin="16">
        <TextBlock Text="{DynamicResource S.MR.Hint}"
                   Foreground="{StaticResource BrushTextDim}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <CheckBox x:Name="ChkProps" Content="{DynamicResource S.MR.Props}" Margin="0,0,0,8"/>
        <CheckBox x:Name="ChkConns" Content="{DynamicResource S.MR.Conns}" Margin="0,0,0,14"/>

        <Border Background="{StaticResource BrushPanelAlt}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <CheckBox x:Name="ChkSymmetrize" Content="{DynamicResource S.MR.MakeSymmetric}"/>
                <TextBlock Text="{DynamicResource S.MR.MakeSymmetricHint}"
                           Foreground="{StaticResource BrushWarnText}" FontSize="11"
                           TextWrapping="Wrap" Margin="22,6,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource S.MR.Ok}" Width="150" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource GenerateButton}" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="{DynamicResource S.MR.Cancel}" Width="110" Height="30"
                    Style="{StaticResource ToolbarButton}" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
