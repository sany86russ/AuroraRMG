<Window x:Class="Olden_Era___Template_Editor.ContentPoolCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.PC.Title}" Width="1020" Height="760"
        MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushText}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="Background" Value="{StaticResource BrushInput}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="RowBackground" Value="{StaticResource BrushInput}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BrushPanelAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BrushPanelAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource S.PC.PoolName}" Margin="0,0,0,4"/>
            <TextBox x:Name="PoolNameBox" MinHeight="30"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{DynamicResource S.Patch.PoolWeightHelp}" TextWrapping="Wrap"
                   Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,10"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S.Patch.PoolGroups}" Margin="0,0,0,6"/>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="+" MinWidth="42" Margin="0,0,6,0" Click="AddGroup_Click"/>
                    <Button Content="−" MinWidth="42" Click="RemoveGroup_Click"/>
                </WrapPanel>
                <DataGrid x:Name="GroupsGrid" SelectionChanged="GroupsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="GroupNumberColumn" Binding="{Binding Label}" Width="65" IsReadOnly="True"/>
                        <DataGridTextColumn x:Name="GroupWeightColumn" Binding="{Binding WeightText,UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{DynamicResource S.PC.Search}" Margin="0,0,0,4"/>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" MinHeight="28"/>
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,8,0,6">
                    <Button DockPanel.Dock="Right" Content="+" MinWidth="40" Margin="8,0,0,0" Click="AddList_Click"/>
                    <ComboBox x:Name="AvailableLists" MinHeight="30" DisplayMemberPath="Name"/>
                </DockPanel>
                <DockPanel Grid.Row="2">
                    <Button DockPanel.Dock="Bottom" Content="{DynamicResource S.Patch.PoolRemoveList}" Margin="0,6,0,0" HorizontalAlignment="Right" Click="RemoveList_Click"/>
                    <ListBox x:Name="SelectedLists" Background="{StaticResource BrushInput}" Foreground="{StaticResource BrushText}"
                             BorderBrush="{StaticResource BrushBorder}" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
                <WrapPanel Grid.Row="3" Margin="0,12,0,6">
                    <Button Content="{DynamicResource S.Patch.PoolCatalogAdd}" Click="AddCatalogObject_Click" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource S.Patch.PoolManualAdd}" Click="AddManualObject_Click" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource S.Patch.PoolRemoveObject}" Click="RemoveObject_Click"/>
                </WrapPanel>
                <DataGrid Grid.Row="4" x:Name="ContentGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SID" Binding="{Binding Sid,UpdateSourceTrigger=PropertyChanged}" Width="230"/>
                        <DataGridTextColumn x:Name="ItemWeightColumn" Binding="{Binding WeightText,UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn x:Name="VariantColumn" Binding="{Binding VariantText,UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn x:Name="BiomeColumn" Binding="{Binding Biome,UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{DynamicResource S.PC.Create}" MinWidth="110" Margin="12,0,0,0" Click="CreatePool_Click"/>
            <StackPanel>
                <CheckBox x:Name="EmbedListsBox" Content="{DynamicResource S.Patch.PoolEmbedLists}"/>
                <TextBlock x:Name="SourceStatus" TextWrapping="Wrap" Foreground="{StaticResource BrushTextDim}" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
