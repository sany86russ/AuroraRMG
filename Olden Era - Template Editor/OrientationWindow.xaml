<Window x:Class="Olden_Era___Template_Editor.OrientationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.OR.Title}"
        Height="640" Width="520" MinWidth="480" MinHeight="380"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}"
        UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S.OR.Hint}"
                   Foreground="{StaticResource BrushTextDim}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="TextBlock" x:Key="Lbl">
                    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Width" Value="200"/>
                </Style>
                <Style TargetType="TextBlock" x:Key="Hdr">
                    <Setter Property="Foreground" Value="{StaticResource BrushGold}"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Margin" Value="0,8,0,6"/>
                </Style>
            </StackPanel.Resources>

            <TextBlock Style="{StaticResource Hdr}" Text="{DynamicResource S.OR.OrientHeader}"/>

            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S.OR.Mode}"/>
                <ComboBox x:Name="CmbMode" IsEditable="True" Height="26" VerticalContentAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S.OR.ZeroAngleZone}"/>
                <ComboBox x:Name="CmbZeroZone" IsEditable="True" Height="26" VerticalContentAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S.OR.BaseAngleMin}"/>
                <TextBox x:Name="TxtBaseMin" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S.OR.BaseAngleMax}"/>
                <TextBox x:Name="TxtBaseMax" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S.OR.RandAmp}"/>
                <TextBox x:Name="TxtRandAmp" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S.OR.RandStep}"/>
                <TextBox x:Name="TxtRandStep" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
            </DockPanel>

            <TextBlock Style="{StaticResource Hdr}" Text="{DynamicResource S.OR.BorderHeader}"/>

            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S.OR.CornerRadius}"/>
                <TextBox x:Name="TxtCorner" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S.OR.ObstaclesWidth}"/>
                <TextBox x:Name="TxtObstWidth" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S.OR.WaterWidth}"/>
                <TextBox x:Name="TxtWaterWidth" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S.OR.WaterType}"/>
                <ComboBox x:Name="CmbWaterType" IsEditable="True" Height="26" VerticalContentAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource S.OR.Apply}" Width="130" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource GenerateButton}" Click="BtnApply_Click"/>
            <Button Content="{DynamicResource S.OR.Close}" Width="110" Height="30"
                    IsCancel="True" Style="{StaticResource ToolbarButton}" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
