<Window x:Class="Olden_Era___Template_Editor.EditorHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.HW.Title}"
        Height="640" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}"
        UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S.HW.Heading}"
                   Foreground="{StaticResource BrushGold}" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="TextBlock" x:Key="Sec">
                        <Setter Property="Foreground" Value="{StaticResource BrushGold}"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Margin" Value="0,10,0,4"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                    </Style>
                    <Style TargetType="TextBlock" x:Key="Body">
                        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="LineHeight" Value="18"/>
                    </Style>
                </StackPanel.Resources>

                <TextBlock Style="{StaticResource Sec}"  Text="{DynamicResource S.HW.SecCanvas}"/>
                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource S.HW.SecCanvasBody}"/>
                <TextBlock Style="{StaticResource Sec}"  Text="{DynamicResource S.HW.SecInspector}"/>
                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource S.HW.SecInspectorBody}"/>
                <TextBlock Style="{StaticResource Sec}"  Text="{DynamicResource S.HW.SecBiome}"/>
                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource S.HW.SecBiomeBody}"/>
                <TextBlock Style="{StaticResource Sec}"  Text="{DynamicResource S.HW.SecRoads}"/>
                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource S.HW.SecRoadsBody}"/>
                <TextBlock Style="{StaticResource Sec}"  Text="{DynamicResource S.HW.SecPools}"/>
                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource S.HW.SecPoolsBody}"/>
                <TextBlock Style="{StaticResource Sec}"  Text="{DynamicResource S.HW.SecTools}"/>
                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource S.HW.SecToolsBody}"/>
                <TextBlock Style="{StaticResource Sec}"  Text="{DynamicResource S.HW.SecMirror}"/>
                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource S.HW.SecMirrorBody}"/>
                <TextBlock Style="{StaticResource Sec}"  Text="{DynamicResource S.HW.SecImport}"/>
                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource S.HW.SecImportBody}"/>
                <TextBlock Style="{StaticResource Sec}"  Text="{DynamicResource S.HW.SecHotkeys}"/>
                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource S.HW.SecHotkeysBody}"/>
                <TextBlock Style="{StaticResource Sec}"  Text="{DynamicResource S.HW.SecLegend}"/>
                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource S.HW.SecLegendBody}"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="{DynamicResource S.HW.Close}" HorizontalAlignment="Right"
                Margin="0,12,0,0" Width="120" Height="30" IsCancel="True"
                Style="{StaticResource ToolbarButton}" Click="BtnClose_Click"/>
    </Grid>
</Window>
