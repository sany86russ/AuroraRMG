<Window x:Class="Olden_Era___Template_Editor.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:OldenEraTemplateEditor.Models"
        xmlns:loc="clr-namespace:Olden_Era___Template_Editor.Services.Localization"
        Title="{DynamicResource S.CM.Title}"
        Height="600" Width="1040"
        MinWidth="760" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}"
        UseLayoutRounding="True">
    <Window.Resources>
        <loc:GameTokenConverter x:Key="GameToken"/>
        <DataTemplate x:Key="ConnectionTypeLabel">
            <TextBlock Text="{Binding Converter={StaticResource GameToken}}" ToolTip="{Binding}"/>
        </DataTemplate>
        <!-- DataGridTextColumn generates its own TextBlock, which does NOT pick up the grid's or the
             cell's Foreground — without this the rows rendered almost unreadable on the dark theme. -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellTextEdit" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Background" Value="{StaticResource BrushInput}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S.CM.Hint}"
                   Foreground="{StaticResource BrushTextDim}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" x:Name="TxtCount" Foreground="{StaticResource BrushTextDim}"
                   FontSize="11" Margin="2,0,0,8"/>

        <DataGrid Grid.Row="2" x:Name="Grid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource BrushInput}"
                  Foreground="{StaticResource BrushText}"
                  FontSize="12"
                  BorderBrush="{StaticResource BrushBorder}"
                  BorderThickness="1"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#15FFFFFF">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource BrushPanelAlt}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushGold}"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <!-- DataGridCell keeps its own (system) foreground, so the grid-level Foreground never
                 reaches the cell text and every row rendered near-invisible on the dark theme. -->
            <!-- WPF's stock DataGridRow paints its text with the SYSTEM control brush (near-black),
                 which is invisible on the Aurora background. -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Height" Value="26"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushGold}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColName" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellTextEdit}" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                <DataGridTextColumn x:Name="ColFrom" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellTextEdit}" Binding="{Binding From}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColTo" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellTextEdit}" Binding="{Binding To}" Width="140" IsReadOnly="True"/>
                <DataGridTemplateColumn x:Name="ColType" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ConnectionType, Converter={StaticResource GameToken}, TargetNullValue=''}"
                                       Style="{StaticResource CellText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{x:Static models:KnownValues.ConnectionTypes}"
                                      ItemTemplate="{StaticResource ConnectionTypeLabel}"
                                      SelectedItem="{Binding ConnectionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="ColGuard" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellTextEdit}" Binding="{Binding GuardValue, TargetNullValue=''}" Width="80"/>
                <DataGridTextColumn x:Name="ColRandom" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellTextEdit}" Binding="{Binding GuardRandomization, TargetNullValue=''}" Width="90"/>
                <DataGridCheckBoxColumn x:Name="ColRoad" Binding="{Binding Road}" Width="70"/>
                <DataGridCheckBoxColumn x:Name="ColEscape" Binding="{Binding GuardEscape}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource S.CM.Apply}" Width="130" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource GenerateButton}" Click="BtnApply_Click"/>
            <Button Content="{DynamicResource S.CM.Close}" Width="110" Height="30"
                    IsCancel="True" Style="{StaticResource ToolbarButton}" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
