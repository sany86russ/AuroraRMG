<Window x:Class="Olden_Era___Template_Editor.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.HK.Title}"
        Height="620" Width="560"
        MinWidth="480" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}"
        UseLayoutRounding="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S.HK.Hint}"
                   Foreground="{StaticResource BrushTextDim}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows"/>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="TxtConflict"
                   Foreground="{StaticResource BrushWarnText}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource S.HK.Reset}" Width="150" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource ToolbarButton}" Click="BtnReset_Click"/>
            <Button Content="{DynamicResource S.HK.Ok}" Width="120" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource GenerateButton}" Click="BtnOk_Click"/>
            <Button Content="{DynamicResource S.HK.Cancel}" Width="110" Height="30"
                    Style="{StaticResource ToolbarButton}" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
